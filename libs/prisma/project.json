{
  "targets": {
    "generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx prisma generate --schema libs/prisma/schemas"
      }
    },
    "push": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx prisma db push --schema libs/prisma/schemas --config libs/prisma/prisma.config.ts"
      }
    }
  }
}
